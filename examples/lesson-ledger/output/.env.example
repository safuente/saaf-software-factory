# Copy to .env. The factory overwrites the first block per worktree; never commit .env.
COMPOSE_PROJECT_NAME=lesson-ledger
APP_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
# Listed for the factory's slot convention; unused (ADR-001: no Redis).
REDIS_PORT=6379
# APP_URL: frontend origin opened in the browser and by Playwright.
APP_URL=http://localhost:3000
# API_URL: backend base URL, used by backend API tests and tooling.
API_URL=http://localhost:8000

# Local-only placeholder database credentials, injected into containers at runtime.
POSTGRES_USER=lessonledger
POSTGRES_PASSWORD=lessonledger-local-only
POSTGRES_DB=lessonledger

# Secure flag of the ll_session cookie. Must be true whenever the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
