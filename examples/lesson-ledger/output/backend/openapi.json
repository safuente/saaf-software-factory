{
  "components": {
    "schemas": {
      "AddStudentRequest": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "AddStudentRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LessonOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "duration_minutes": {
            "title": "Duration Minutes",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "paid": {
            "title": "Paid",
            "type": "boolean"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "student": {
            "$ref": "#/components/schemas/StudentRef"
          }
        },
        "required": [
          "id",
          "student",
          "date",
          "duration_minutes",
          "price",
          "paid",
          "created_at"
        ],
        "title": "LessonOut",
        "type": "object"
      },
      "LogInRequest": {
        "description": "No format or length rules: any mismatch is reported as invalid credentials.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LogInRequest",
        "type": "object"
      },
      "Money": {
        "description": "Integer minor units plus ISO 4217 code (conventions \u00a74, ADR-003).",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "MoneyIn": {
        "properties": {
          "amount": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Amount",
            "type": "integer"
          },
          "currency": {
            "const": "USD",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "MoneyIn",
        "type": "object"
      },
      "MonthlySummary": {
        "description": "Totals of the teacher's lessons dated in `month` (ADR-003, F03 Behavior: Totals).",
        "properties": {
          "collected": {
            "$ref": "#/components/schemas/Money"
          },
          "lesson_count": {
            "title": "Lesson Count",
            "type": "integer"
          },
          "month": {
            "title": "Month",
            "type": "string"
          },
          "pending": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "month",
          "lesson_count",
          "collected",
          "pending"
        ],
        "title": "MonthlySummary",
        "type": "object"
      },
      "Page_LessonOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LessonOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "Page[LessonOut]",
        "type": "object"
      },
      "Page_StudentOut_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/StudentOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "Page[StudentOut]",
        "type": "object"
      },
      "PendingLessons": {
        "description": "One page of unpaid lessons; `amount_pending` sums every unpaid lesson of the teacher.",
        "properties": {
          "amount_pending": {
            "$ref": "#/components/schemas/Money"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LessonOut"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "amount_pending"
        ],
        "title": "PendingLessons",
        "type": "object"
      },
      "RecordLessonRequest": {
        "description": "Unknown fields, including `paid`, are ignored: a lesson always starts unpaid.",
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "duration_minutes": {
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "price": {
            "$ref": "#/components/schemas/MoneyIn"
          },
          "student_id": {
            "title": "Student Id",
            "type": "integer"
          }
        },
        "required": [
          "student_id",
          "date",
          "duration_minutes",
          "price"
        ],
        "title": "RecordLessonRequest",
        "type": "object"
      },
      "SessionBody": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "teacher": {
            "$ref": "#/components/schemas/TeacherOut"
          }
        },
        "required": [
          "teacher",
          "expires_at"
        ],
        "title": "SessionBody",
        "type": "object"
      },
      "SetPaidRequest": {
        "additionalProperties": false,
        "description": "The only change to a lesson (Q3): any other field is rejected, so no other lesson data\ncan be modified.",
        "properties": {
          "paid": {
            "title": "Paid",
            "type": "boolean"
          }
        },
        "required": [
          "paid"
        ],
        "title": "SetPaidRequest",
        "type": "object"
      },
      "SignUpRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpRequest",
        "type": "object"
      },
      "StudentOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "title": "StudentOut",
        "type": "object"
      },
      "StudentRef": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "StudentRef",
        "type": "object"
      },
      "TeacherOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "TeacherOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Lesson Ledger API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Healthy only if the database answers. Public; reveals nothing beyond up or down.",
        "operationId": "getApiHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Database is not reachable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/lessons": {
      "get": {
        "description": "The teacher's lessons by date, newest first; same date newest created first.\n`month` keeps only the lessons dated in that month.",
        "operationId": "listLessons",
        "parameters": [
          {
            "description": "Calendar month YYYY-MM, 2000-01 to 2099-12",
            "in": "query",
            "name": "month",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^20\\d{2}-(0[1-9]|1[0-2])$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Calendar month YYYY-MM, 2000-01 to 2099-12",
              "title": "Month"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_LessonOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "List Lessons",
        "tags": [
          "lessons"
        ]
      },
      "post": {
        "description": "Record an unpaid lesson for one of the teacher's students; 404 for any other student.",
        "operationId": "recordLesson",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordLessonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found, or not the teacher's"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body is not JSON"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "Record Lesson",
        "tags": [
          "lessons"
        ]
      }
    },
    "/api/lessons/{lesson_id}": {
      "patch": {
        "description": "Mark the teacher's lesson as paid or undo it; idempotent. 404 for any other lesson.",
        "operationId": "setLessonPaid",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetPaidRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LessonOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found, or not the teacher's"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body is not JSON"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "Set Lesson Paid",
        "tags": [
          "lessons"
        ]
      }
    },
    "/api/monthly-summaries/{month}": {
      "get": {
        "description": "Lesson count, collected (paid) and pending (unpaid) amounts of the teacher's lessons\ndated in `month`.",
        "operationId": "getMonthlySummary",
        "parameters": [
          {
            "description": "Calendar month YYYY-MM, 2000-01 to 2099-12",
            "in": "path",
            "name": "month",
            "required": true,
            "schema": {
              "description": "Calendar month YYYY-MM, 2000-01 to 2099-12",
              "pattern": "^20\\d{2}-(0[1-9]|1[0-2])$",
              "title": "Month",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthlySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "Get Monthly Summary",
        "tags": [
          "lessons"
        ]
      }
    },
    "/api/pending-lessons": {
      "get": {
        "description": "The teacher's unpaid lessons of every month by date, oldest first; same date oldest\ncreated first. `amount_pending` covers all of them, not only this page.",
        "operationId": "listPendingLessons",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingLessons"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "List Pending Lessons",
        "tags": [
          "lessons"
        ]
      }
    },
    "/api/sessions": {
      "post": {
        "description": "Log in with email and password; replaces any session the request carried.",
        "operationId": "logIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Email or password is incorrect"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Body is not JSON"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or non-string field"
          }
        },
        "summary": "Log In",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/sessions/current": {
      "delete": {
        "description": "Delete the session on the server and clear the cookie.",
        "operationId": "logOut",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          }
        },
        "summary": "Log Out",
        "tags": [
          "accounts"
        ]
      },
      "get": {
        "description": "The logged-in teacher and when the session expires.",
        "operationId": "getCurrentSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          }
        },
        "summary": "Get Current Session",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/students": {
      "get": {
        "description": "The teacher's students by name (case-insensitive), ties oldest first.",
        "operationId": "listStudents",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_StudentOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid input"
          }
        },
        "summary": "List Students",
        "tags": [
          "students"
        ]
      },
      "post": {
        "description": "Add a student with a trimmed name of 1 to 100 characters.",
        "operationId": "addStudent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddStudentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No valid session"
          },
          "415": {
            "content": {
