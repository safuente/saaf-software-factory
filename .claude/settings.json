{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(./projects/**)",
      "Edit(./runs/**)",
      "Edit(./workspaces/**)",

      "WebSearch",
      "WebFetch",

      "Bash(make:*)",
      "Bash(git:*)",
      "Bash(docker:*)",
      "Bash(uv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pip-audit:*)",
      "Bash(semgrep:*)",
      "Bash(bandit:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(say:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl * http://localhost:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git * push:*)",
      "Bash(git * push)",
      "Bash(git remote add:*)",
      "Bash(git * remote add:*)",
      "Bash(gh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git * push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git * push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git * reset --hard:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)"
    ]
  }
}
